{
  "name": "spacebridge",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "drizzle-orm": "^0.40.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "*",
    "bun-types": "^1.3.11",
    "drizzle-kit": "^0.30.0",
    "husky": "latest",
    "lint-staged": "latest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
